# Local dev values. Prod values live in /srv/rugby-coaching/.env (never committed).
# Generate prod keys with: python -c "import secrets; print(secrets.token_urlsafe(24))"
COACH_KEY=dev-coach
PLAYER_KEY=dev-player
SECRET_KEY=dev-secret-change-me
HTTPS_ONLY=false

# Display name only. The internal slug is always rugby-coaching (see docs/decisions.md D26).
APP_NAME=Rugby Coaching

# Comma-separated. Names are added to the coaches table on startup (never removed).
COACHES=John,Coach Two,Coach Three
DEFAULT_START_TIME=18:30
# Monday = 0 … Sunday = 6. New sessions default to the next one.
TRAINING_WEEKDAY=2
